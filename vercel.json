{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{*.php,includes/**,assets/css/**,assets/img/**,assets/video/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(includes|data|tools|api)(/.*)?",
      "status": 404
    },
    {
      "src": "/.*\\.(php|md|sqlite|json|lock)$",
      "status": 404
    },
    {
      "src": "/\\..*",
      "status": 404
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
